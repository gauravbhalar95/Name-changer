{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/index",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    { "source": "/webhook", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/", "destination": "/api/index" }
  ]
}
